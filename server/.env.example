# =============================================================================
# AtmoSense AI — Server Environment Template (SERVER-SIDE ONLY)
# =============================================================================

NODE_ENV="development"
PORT="3000"

# Google Gemini API Key (strictly server-side)
GEMINI_API_KEY="YOUR_SERVER_SIDE_GEMINI_API_KEY"
GEMINI_MODEL="gemini-4-hydrogen"

# Allowed CORS origin (optional; defaults to APP_URL / same-origin)
APP_URL="http://localhost:3000"

# Open-Meteo Air Quality API (keyless public meteorological feed)
OPEN_METEO_AQ_URL="https://air-quality-api.open-meteo.com/v1/air-quality"

# Multi-Source Live Air Quality API Keys (SERVER-SIDE ONLY)
WAQI_API_TOKEN="YOUR_SERVER_SIDE_WAQI_TOKEN"
OPENAQ_API_KEY="YOUR_OPTIONAL_OPENAQ_API_KEY"
OPENWEATHER_API_KEY="YOUR_SERVER_SIDE_OPENWEATHER_API_KEY"
