# =============================================================================
# AtmoSense AI — Root Environment Variable Template
# SECURITY: ALL secret API keys are server-side only. Never prefix secrets with VITE_.
# =============================================================================

# Server runtime
NODE_ENV="development"
PORT="3000"

# Google Gemini 2.5 Pro API Key (SERVER-SIDE ONLY)
# Automatically injected by AI Studio from Settings > Secrets.
GEMINI_API_KEY="YOUR_SERVER_SIDE_GEMINI_API_KEY"

# Gemini model identifier (SERVER-SIDE ONLY)
GEMINI_MODEL="gemini-4-hydrogen"

# Public application URL for CORS & metadata
APP_URL="http://localhost:3000"

# Open-Meteo Air Quality upstream endpoint (no API key required)
OPEN_METEO_AQ_URL="https://air-quality-api.open-meteo.com/v1/air-quality"

# Multi-Source Live Air Quality API Keys (SERVER-SIDE ONLY)
WAQI_API_TOKEN="YOUR_SERVER_SIDE_WAQI_TOKEN"
OPENAQ_API_KEY="YOUR_OPTIONAL_OPENAQ_API_KEY"
OPENWEATHER_API_KEY="YOUR_SERVER_SIDE_OPENWEATHER_API_KEY"
